# Production Caddyfile
# Set DOMAIN env var for HTTPS, otherwise serves HTTP on port 80

{
    servers {
        # All traffic arrives through Cloudflare, so the connecting address is
        # a Cloudflare server. Only believe its CF-Connecting-IP header when the
        # request really comes from Cloudflare, otherwise anyone reaching the
        # origin directly could fake it.
        # Ranges from https://www.cloudflare.com/ips/
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

{$DOMAIN::80} {
    # Automatic HTTPS with Let's Encrypt
    # (only works with real domain, not localhost)

    # Reverse proxy to Nuxt app
    reverse_proxy app:3000 {
        # The app is down for a few seconds while a deploy swaps it, so hold requests
        # and retry until it's back rather than answering 503. Active health checks
        # are left off: with one upstream they only keep it marked down until the
        # next check, long after it has recovered.
        lb_try_duration 30s
        lb_try_interval 250ms

        # Headers
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }

    # Compression
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Logging
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
