# Production Caddyfile
# Set DOMAIN env var for HTTPS, otherwise serves HTTP on port 80

{$DOMAIN::80} {
    # Automatic HTTPS with Let's Encrypt
    # (only works with real domain, not localhost)

    # Reverse proxy to Nuxt app
    reverse_proxy app:3000 {
        # The app is down for a few seconds while a deploy swaps it, so hold requests
        # and retry until it's back rather than answering 503. Active health checks
        # are left off: with one upstream they only keep it marked down until the
        # next check, long after it has recovered.
        lb_try_duration 30s
        lb_try_interval 250ms

        # Headers
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Compression
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Logging
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
